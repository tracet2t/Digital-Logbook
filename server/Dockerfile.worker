FROM node:22.7.0-alpine AS base

# ─── Install Dependencies ─────────────────────────────────────────────────────

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
# Install all deps (including devDeps) so tsx is available at runtime
RUN npm install

# ─── Build (Prisma client generation) ────────────────────────────────────────

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate

# ─── Runner ───────────────────────────────────────────────────────────────────

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY --from=builder --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/src ./src
COPY --from=builder --chown=worker:nodejs /app/prisma ./prisma
COPY --from=builder --chown=worker:nodejs /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=worker:nodejs /app/package.json ./package.json

USER worker

CMD ["node_modules/.bin/tsx", "src/worker/index.ts"]
