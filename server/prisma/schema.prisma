generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  firstName        String
  lastName         String
  emailConfirmed   Boolean          @default(false)
  role             Role
  isActive         Boolean          @default(true)
  isFirstTimeLogin Boolean          @default(true)
  invitedBy        String?
  batchNo          String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  activities       Activity[]
  mentorFeedback   MentorFeedback[]
  mentorReports    Report[]         @relation(name: "mentorReports")

  mentorActivities MentorActivity[] @relation(name: "UserMentorActivities")

  badges           UserBadge[]

  warningStatuses  WarningStatus[]

  invitationsSent  Invitation[]     @relation("InvitationSender")

  projectAllocations ProjectAllocation[] @relation(name: "StudentProjects")

  mentorAllocations ProjectMentor[]  @relation(name: "MentorProjects")

  projectTechnologies ProjectTechnology[]

  articles     Article[]        @relation("ArticleAuthor")

  @@map("users")
}

model Activity {
  id        String         @id @default(uuid())
  studentId String
  date      DateTime
  timeSpent Int
  notes     String?
  technologies String[]    @default([])
  status    ActivityStatus @default(pending)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  student   User           @relation(fields: [studentId], references: [id])

  feedback  MentorFeedback[]

  @@map("activities")
}

model MentorFeedback {
  id            String         @id @default(uuid())
  activityId    String
  mentorId      String
  status        FeedbackStatus
  feedbackNotes String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  activity      Activity       @relation(fields: [activityId], references: [id])
  mentor        User           @relation(fields: [mentorId], references: [id])

  @@map("mentorfeedback")
}

model Report {
  id          String        @id @default(uuid())
  mentorId    String
  reportData  Json
  status      ProcessStatus @default(pending)
  generatedAt DateTime      @default(now())

  mentor      User          @relation(fields: [mentorId], references: [id], name: "mentorReports")

  @@map("reports")
}

model MentorActivity {
  id           String   @id @default(cuid())
  mentorId     String
  date         DateTime
  workingHours Int
  activities   String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mentor       User     @relation(fields: [mentorId], references: [id], name: "UserMentorActivities")

  @@map("mentorActivities")
}

model Invitation {
  id         String   @id @default(uuid())
  email      String
  role       Role @default(student)
  token      String   @unique
  invitedBy  String?
  projectId  String?
  expiresAt  DateTime
  accepted   Boolean  @default(false)

  createdAt  DateTime @default(now())

  inviter    User?     @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("invitations")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  domain      String
  batchNo     String?
  projectOrder Int          @default(0)

  createdBy   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentors     ProjectMentor[]
  assignments ProjectAllocation[]
  invitations Invitation[]
  technologies ProjectTechnology[]

  @@map("projects")
}

model ProjectAllocation {
  id        String   @id @default(uuid())
  projectId String
  studentId String

  assignedAt DateTime @default(now())
  timeAllocationStatus TimeAllocationStatus @default(inReview)

  project    Project  @relation(fields: [projectId], references: [id])
  student    User     @relation(fields: [studentId], references: [id], name: "StudentProjects")

  @@unique([projectId, studentId])
  @@map("ProjectAllocations")
}

model ProjectMentor {
  id         String   @id @default(uuid())
  projectId  String
  mentorId   String

  assignedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id])
  mentor     User     @relation(fields: [mentorId], references: [id], name: "MentorProjects")

  @@unique([projectId, mentorId])
  @@map("projectMentors")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconUrl     String?

  createdAt   DateTime @default(now())

  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String

  awardedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@map("userBadges")
}

enum Role {
  student
  mentor
  superAdmin
}

enum FeedbackStatus {
  approved
  rejected
  pending
}

enum ActivityStatus {
  pending
  accepted
  rejected
}

enum ProcessStatus {
  pending
  error
  completed
  wip
}

model ProjectTechnology {
  id        String   @id @default(uuid())
  projectId String
  studentId String
  name      String
  rating    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([projectId, studentId, name])
  @@map("projectTechnologies")
}

enum TimeAllocationStatus {
  inReview
  accepted
  rejected
}

model MenteeApplication {
  id            String                    @id @default(uuid())
  fullName      String
  email         String                    @unique
  university    String
  degreeProgram String
  cvLink        String
  status        MenteeApplicationStatus   @default(pending)

  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@map("menteeApplications")
}

enum MenteeApplicationStatus {
  pending
  approved
  rejected
  inactive
}

enum WarningCategory {
  low
  medium
  high
}

model WarningStatus {
  id          String          @id @default(uuid())
  studentId   String
  comment     String
  warningType WarningCategory?
  student     User            @relation(fields: [studentId], references: [id])

  @@map("warningStatuses")
}

// CMS 

model Article {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String        @db.Text
  featuredImage String?
  status        ArticleStatus @default(DRAFT)
  isHero        Boolean       @default(false)
  isEvent       Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Only superAdmin users can author articles
  authorId      String
  author        User          @relation("ArticleAuthor", fields: [authorId], references: [id])

  tags          ArticleTag[]
  seo           ArticleSeo?
  event         ArticleEvent?

  @@map("articles")
}

model ArticleTag {
  id        String  @id @default(cuid())
  articleId String
  label     String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, label])
  @@map("articleTags")
}

model ArticleSeo {
  id          String  @id @default(cuid())
  articleId   String  @unique
  metaTitle   String?
  metaDesc    String?
  ogImage     String?

  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("articleSeo")
}

model ArticleEvent {
  id          String   @id @default(cuid())
  articleId   String   @unique
  eventDate   DateTime?
  eventTime   String?
  location    String?
  tag         String?

  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("articleEvents")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}