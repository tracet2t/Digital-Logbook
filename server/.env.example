BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRY="60 min"
ISSUER=http://localhost:3000
AUDIENCE=http://localhost:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (Google App Password — https://myaccount.google.com/apppasswords)
EMAIL_USER="sample@gmail.com"
EMAIL_PASS="aaaa bbbb cccc dddd"

# NIC Encryption — RSA-2048 keys, base64-encoded PEM
# Generate with:
#   openssl genrsa -out nic_rsa_priv.pem 2048
#   openssl rsa -in nic_rsa_priv.pem -pubout -out nic_rsa_pub.pem
#   base64 -w 0 nic_rsa_pub.pem   → paste as NIC_SSH_PUB_KEY_B64
#   base64 -w 0 nic_rsa_priv.pem  → paste as NIC_SSH_PRIV_KEY_B64
NIC_SSH_PUB_KEY_B64=
NIC_SSH_PRIV_KEY_B64=